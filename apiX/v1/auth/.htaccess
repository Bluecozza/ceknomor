# Teruskan semua request ke index.php di folder ini
# Mencegah 403 karena Apache mencoba serve direktori
Options -Indexes
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /
    RewriteRule ^$ index.php [QSA,L]
    RewriteRule ^index\.php$ - [L]
    RewriteRule ^ index.php [QSA,L]
</IfModule>
