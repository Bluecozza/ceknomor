# ============================================================
# cek.resource.my.id — Environment Configuration
# Salin file ini ke .env dan sesuaikan nilainya
# JANGAN commit file .env ke version control!
# ============================================================

# ── Aplikasi ──────────────────────────────────────────────────
APP_ENV=development
# APP_ENV=production

# ── Database ──────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_NAME=cek_resource
DB_USER=root
DB_PASS=

# ── Keamanan ──────────────────────────────────────────────────
# Generate dengan: php -r "echo bin2hex(random_bytes(32));"
APP_KEY=your_random_app_key_here_min_32_chars

# Generate dengan: php -r "echo bin2hex(random_bytes(32));"
JWT_SECRET=your_jwt_secret_here_min_32_chars

# ── Upload ────────────────────────────────────────────────────
# Direktori upload relatif terhadap root project
UPLOAD_PATH=public/uploads
# Ukuran maksimum file upload dalam bytes (default: 5MB)
UPLOAD_MAX_SIZE=5242880
