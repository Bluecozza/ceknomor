# ============================================================
# .htaccess — cek.resource.my.id
# ============================================================

Options -Indexes
Options -MultiViews

RewriteEngine On
RewriteBase /

# ── Authorization header passthrough ─────────────────────────
RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
<IfModule mod_setenvif.c>
    SetEnvIfNoCase ^Authorization$ "(.+)" HTTP_AUTHORIZATION=$1
</IfModule>
CGIPassAuth On

# ── Jangan redirect trailing slash ───────────────────────────
<IfModule mod_dir.c>
    DirectorySlash Off
</IfModule>

# ── Security Headers ──────────────────────────────────────────
<IfModule mod_headers.c>
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header unset X-Powered-By
    Header always unset X-Powered-By
    Header always set Access-Control-Allow-Origin "*"
    Header always set Access-Control-Allow-Methods "GET, POST, PUT, DELETE, OPTIONS"
    Header always set Access-Control-Allow-Headers "Content-Type, Authorization, X-API-Key, X-Requested-With"
</IfModule>

# ── Blokir file sensitif ──────────────────────────────────────
<FilesMatch "\.(sql|env|log|sh|bak|git)$">
    Require all denied
</FilesMatch>

# Blokir akses ke folder sensitif (hanya root-level)
RewriteRule ^config(/|$)  - [F,L]
RewriteRule ^core(/|$)    - [F,L]
RewriteRule ^logs(/|$)    - [F,L]
RewriteRule ^storage(/|$) - [F,L]

# ── OPTIONS preflight ─────────────────────────────────────────
RewriteCond %{REQUEST_METHOD} OPTIONS
RewriteRule ^ - [R=204,L]

# ── SEMUA REQUEST API → api.php ───────────────────────────────
# Ini adalah fix utama: tidak ada direktori fisik yang diakses
# PHP di api.php yang menangani semua routing
RewriteRule ^api/v1(/.*)?$ api.php [QSA,L]

# ── File statis fisik (CSS, JS, gambar) ──────────────────────
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]

# ── Admin Panel ───────────────────────────────────────────────
RewriteRule ^admin/?$    admin/index.php [QSA,L]
RewriteRule ^admin/.+$   admin/index.php [QSA,L]

# ── Frontend ──────────────────────────────────────────────────
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.php [QSA,L]

# ── Compression & Caching ────────────────────────────────────
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css
    AddOutputFilterByType DEFLATE application/javascript application/json
</IfModule>
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpeg  "access plus 1 month"
    ExpiresByType image/png   "access plus 1 month"
    ExpiresByType image/webp  "access plus 1 month"
    ExpiresByType text/css    "access plus 1 week"
    ExpiresByType application/javascript "access plus 1 week"
</IfModule>
